<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.kh.team3.dao.CommentDAO">
	<insert id="insertComment">
		insert into comment(co_content, co_me_num, co_cl_num)
		value(#{co_content}, #{co_me_num}, #{co_cl_num})
	</insert>
	
	<select id="getCommentList" parameterType="int" resultType="kr.kh.team3.model.vo.CommentVO">
		select * from comment where co_cl_num = #{cl_num}
	</select>
</mapper>