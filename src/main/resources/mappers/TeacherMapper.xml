<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.kh.team3.dao.TeacherDAO">
	<select id="selectIntro" resultType="kr.kh.team3.model.vo.TeacherVO">
	    select * from teacher where tc_me_num = #{tc_me_num};
	</select>
	
	<insert id="insertContent" parameterType="map">
	  INSERT INTO teacher (TC_INTRO, TC_ME_NUM)
	  VALUES (#{map.tc_intro}, #{map.tc_me_num})
	</insert>
	
    <update id="updateContent">
    	update teacher set tc_intro = #{map.tc_intro} where tc_me_num = #{map.tc_me_num}
    </update>
    
    <select id="selectTcNum" resultType="kr.kh.team3.model.vo.MemberVO">
    	select member.* from member join
        teacher on tc_me_num = me_num
        where tc_me_num=#{tc_me_num}
    </select>
    
    <select id="getClassesWithThumbnail" resultMap="classWithThumbnailResultMap">
    SELECT c.cl_id, c.cl_title, t.th_picture
    FROM class c
    LEFT JOIN thumbnail t ON c.cl_id = t.th_cl_num
    WHERE c.tc_me_num = #{tc_me_num};
</select>

<resultMap id="classWithThumbnailResultMap" type="kr.kh.team3.model.vo.ClassVO">
    <result property="cl_id" column="cl_id"/>
    <result property="cl_title" column="cl_title"/>
    <result property="thumbnail.th_picture" column="th_picture"/>  <!-- 썸네일 매핑 -->
</resultMap>
</mapper>